---
import { siteInfo } from "../config";
interface Props { to: string }
const { to } = Astro.props;
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>页面已迁移 · {siteInfo.title}</title><meta http-equiv="refresh" content={`0;url=${to}`} /><link rel="canonical" href={new URL(to, siteInfo.url)} /></head><body><p>页面已迁移，<a href={to}>继续浏览文章</a>。</p></body></html>
