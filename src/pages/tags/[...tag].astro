---
import { getPosts, getTags, summarize } from "../../lib/posts";
import { withBase } from "../../lib/urls";
import LegacyRedirect from "../../components/LegacyRedirect.astro";
export async function getStaticPaths() {
  const tags = getTags((await getPosts()).map(summarize));
  const routes = new Map(tags.map(tag => [tag, tag]));
  // Original AstroPaper links, retained across the Pudding migration.
  if (tags.includes("Astro")) routes.set("astro", "Astro");
  if (tags.includes("GitHub Pages")) routes.set("github-pages", "GitHub Pages");
  return [...routes].map(([tag, label]) => ({ params: { tag }, props: { label } }));
}
const { label } = Astro.props;
---
<LegacyRedirect to={withBase(`/posts/?tag=${encodeURIComponent(label)}`)} />
