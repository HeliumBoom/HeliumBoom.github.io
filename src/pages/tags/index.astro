---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getPosts, getTags, summarize } from "../../lib/posts";
import { withBase } from "../../lib/urls";
const posts = (await getPosts()).map(summarize);
const tags = getTags(posts);
---
<BlogLayout title="标签" heroTitle="按主题，寻找文章">
  <section class="card page-card"><h1>标签</h1><div class="tag-links">{tags.map(tag => <a class="btn secondary" href={withBase(`/posts/?tag=${encodeURIComponent(tag)}`)}>{tag} · {posts.filter(post => post.tags.includes(tag)).length}</a>)}</div></section>
</BlogLayout>
<style>.tag-links { display:flex; flex-wrap:wrap; gap:12px; }</style>
