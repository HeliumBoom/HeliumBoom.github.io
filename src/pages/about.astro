---
import { withBase } from "../lib/urls";
import BlogLayout from "../layouts/BlogLayout.astro";
import { personalInfo } from "../config";
---
<BlogLayout title="关于" heroTitle="你好，我是 HeliumBoom" heroSubtitle="技术探索 · 开发实践 · 学习与思考">
  <section class="card page-card about-card">
    <div class="about-intro"><img src={personalInfo.avatar} width="90" height="90" alt="HeliumBoom 的花朵头像" /><div><span class="eyebrow">HELLO, I'M HELIUMBOOM</span><h2>欢迎来到我的小站 <span class="accent">✿</span></h2><p>技术笔记 / 开发实践 / 保持好奇</p></div></div>
    <div class="prose">
      <h2>关于我</h2>
      <p>你好，我是 HeliumBoom。这里是一个安静的记录空间，用来整理技术探索、开发实践，以及解决问题时留下的思考。</p>
      <p>这个站点刚刚起步，内容会随着新的实践逐步积累。</p>
      <blockquote><p>让每一篇文章留下一个可以再次找到的答案。</p></blockquote>
      <h2>在这里读到什么</h2>
      <ul><li><strong>技术笔记</strong>：从一个具体问题出发，记录理解它、验证它、解决它的过程。</li><li><strong>开发实践</strong>：工具的使用方式、实现中的取舍，以及可以再次用上的经验。</li><li><strong>学习与思考</strong>：把零散的发现整理成文章，让知识有迹可循。</li></ul>
      <h2>关于本站</h2>
      <p>本站使用 Astro、Vue 与 Tailwind CSS 构建，基于 <a href="https://github.com/sudoriaa/Kanade-Astro/tree/codex/astro-theme">Kanade</a> 主题，托管于 GitHub Pages，并保留了从旧主题迁移而来的圆形明暗切换动画。</p>
      <p>用 Markdown 写作，用 Git 管理，让注意力更多地留在内容上。</p>
    </div>
    <div class="about-links"><a class="btn" href={personalInfo.github} target="_blank" rel="noopener noreferrer"><span class="icon-[jam--github]" aria-hidden="true"></span>GitHub</a><a class="btn secondary" href={withBase("/rss.xml")}>RSS 订阅</a><a class="btn secondary" href={withBase("/posts/")}>读读我的文章<span class="icon-[lucide--arrow-right]" aria-hidden="true"></span></a></div>
    <div class="about-end">谢谢你，在互联网的某个角落找到了这里。<span>✿</span></div>
  </section>
</BlogLayout>
<style>
.about-intro { display: flex; align-items: center; gap: 22px; }
.about-intro img { border-radius: 26px; transform: rotate(-4deg); box-shadow: 5px 5px 0 var(--accent-soft); }
.about-intro .eyebrow { font-size: 9px; }
.about-intro h2 { font-size: 23px; margin: 7px 0; }
.about-intro p { color: var(--muted); font-size: 11px; margin: 0; }
.interest-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.interest-grid > div { border-radius: 12px; background: var(--accent-soft); padding: 20px; }
.interest-grid span { color: var(--accent); font-size: 25px; display: block; margin-bottom: 13px; }
.interest-grid strong { font-size: 14px; font-weight: 400; }
.interest-grid p { font-size: 11px; line-height: 2; color: var(--muted); margin-bottom: 0; }
.about-links { display: flex; flex-wrap: wrap; gap: 12px; margin: 25px 0; font-size: 12px; }
.about-end { text-align: center; border-top: 1px dashed var(--line); margin-top: 32px; padding-top: 25px; color: var(--muted); font-size: 11px; }
.about-end span { display:block; font-size: 22px; color: var(--accent); margin-top: 10px; }
@media(max-width:480px) { .about-intro { flex-direction: column; text-align: center; } .about-intro h2 { font-size: 21px; } .interest-grid { gap: 10px; } .interest-grid > div { padding: 15px; } }
</style>